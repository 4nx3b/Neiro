@@ -43,6 +43,11 @@ enum class GlasmioPerformanceTier(
  *
  * @property frameRateCap glass update rate in Hz (0 = every display frame). The display itself keeps its refresh rate.
  * @property samplingScale explicit backdrop downscale multiplier in 0.25..1, replacing the tier's value.
+ * @property cachedGlass opt in to rendering capped glass off screen in a second renderer and compositing the last
+ *   image ([frameRateCap] below the panel rate). Off by default: that path made the glass layer's render node
+ *   reachable from two renderers, and RenderThread crashed (SIGSEGV, use-after-free) on Android 16 / Mali at
+ *   120 Hz when a page scrolled or a control was tapped. With it off, [frameRateCap] gates the glass clocks only,
+ *   as in 0.2.1.
  */
