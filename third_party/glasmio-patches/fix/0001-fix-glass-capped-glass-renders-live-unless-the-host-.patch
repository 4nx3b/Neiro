@@ -410,13 +410,26 @@ internal class GlassFrameCache(
         private const val MaxImages = 4
 
         /**
-         * Whether a surface in [view] should render through the cache: a positive cap below the panel's refresh
-         * rate, hardware drawing, and plain sRGB output (wide-gamut and HDR windows keep live rendering).
+         * Whether a surface in [view] should render through the cache: the host opted in
+         * ([GlasmioPerformance.cachedGlass]), a positive cap below the panel's refresh rate, hardware drawing, and
+         * plain sRGB output (wide-gamut and HDR windows keep live rendering).
          */
-        fun applies(view: View, hardware: Boolean, colorManaged: Boolean, headroom: Float): Boolean {
-            val cap = GlasmioPerformance.frameRateCap
+        fun applies(view: View, hardware: Boolean, colorManaged: Boolean, headroom: Float): Boolean =
+            applies(GlasmioPerformance.cachedGlass, GlasmioPerformance.frameRateCap, hardware, colorManaged, headroom,
+                view.display?.refreshRate)
+
+        /** Pure so it can be unit tested. The off-screen path is opt-in ([GlasmioPerformance.cachedGlass]). */
+        internal fun applies(
+            cachedGlass: Boolean,
+            cap: Int,
+            hardware: Boolean,
+            colorManaged: Boolean,
+            headroom: Float,
+            refresh: Float?,
+        ): Boolean {
+            if (!cachedGlass) return false
             if (cap <= 0 || !hardware || colorManaged || headroom != 1f) return false
-            val refresh = view.display?.refreshRate ?: return false
+            refresh ?: return false
             return cap < refresh - 1f
         }
     }
