@@ -54,6 +59,8 @@ data class GlasmioPerformanceConfig(
     val backdrop: Boolean? = null,
     /** Force the simple scale+fade menu animation on/off; null follows the tier. */
     val simpleMenus: Boolean? = null,
+    /** Opt in to the off-screen capped-glass renderer; null or false keeps glass live. */
+    val cachedGlass: Boolean? = null,
 )
 
 /**
@@ -108,6 +115,9 @@ object GlasmioPerformance {
         )
     }
 
+    /** Whether capped glass may render off screen and composite its last image. Off unless the host opts in. */
+    val cachedGlass: Boolean get() = state.cachedGlass ?: false
+
     /** Whether menus use the plain scale+fade opening instead of the liquid morph. Snapshot-observed. */
     val simpleMenus: Boolean get() = state.simpleMenus ?: tier.simpleMenus
 
