@@ -0,0 +1,29 @@
+package io.github.neoruaa.glasmio.glass.render
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Regression test for the capped-glass RenderThread crash (SIGSEGV on Android 16 / Mali, 120 Hz, Balanced tier
+ * cap 60): the off-screen renderer must not run unless the host opts in.
+ */
+class GlassFrameCacheOptInTest {
+    @Test fun tierCapAloneNeverEnablesTheCache() {
+        assertFalse(GlassFrameCache.applies(false, 60, true, false, 1f, 120f))
+        assertFalse(GlassFrameCache.applies(false, 30, true, false, 1f, 60f))
+    }
+
+    @Test fun optInWithACapBelowThePanelRateCaches() {
+        assertTrue(GlassFrameCache.applies(true, 60, true, false, 1f, 120f))
+    }
+
+    @Test fun optInStillRendersLiveWhereTheCacheNeverApplied() {
+        assertFalse(GlassFrameCache.applies(true, 0, true, false, 1f, 120f))
+        assertFalse(GlassFrameCache.applies(true, 120, true, false, 1f, 120f))
+        assertFalse(GlassFrameCache.applies(true, 60, false, false, 1f, 120f))
+        assertFalse(GlassFrameCache.applies(true, 60, true, true, 1f, 120f))
+        assertFalse(GlassFrameCache.applies(true, 60, true, false, 2f, 120f))
+        assertFalse(GlassFrameCache.applies(true, 60, true, false, 1f, null))
+    }
+}
